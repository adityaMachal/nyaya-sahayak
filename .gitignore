# ==============================================================================
# Nyaya Sahayak Unified .gitignore
# ==============================================================================

# --- Python & Backend Environment ---
.venv/
.env
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# --- Database & Persistent Storage ---
data/chroma_db/
data/conversations.db
*.db-wal
*.db-shm

# --- Node & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
*.tsbuildinfo
.vercel/

# --- Scratch & Standalone Demos ---
hero_section_done/

# --- Logs & Package Managers ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- OS & Editor Metadata ---
.DS_Store
Thumbs.db
*.pem
